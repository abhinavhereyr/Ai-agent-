# Ollama endpoint used by the Vercel-hosted frontend (if deployed).
# Point this at a public tunnel to your local Ollama instance, e.g.:
#   ngrok:  https://your-ngrok-url.ngrok.io
#   localhost.run: https://your-tunnel-id.lhr.life
# Leave blank to use the default (http://localhost:11434) when running locally.
VITE_OLLAMA_URL=https://your-ngrok-url.ngrok.io
